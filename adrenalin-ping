#!/usr/bin/env python3
# ADRENALIN ping - server-side latency measurement
import json, os, socket, ssl, statistics, subprocess, sys, time, urllib.request, re

CONF="/etc/adrenalin-ping.conf"
OUT="/var/lib/pasarguard/templates/subscription/adr-ping.json"
TIMEOUT=3.0

def load_conf():
    sub_urls=[]; extra=[]
    try:
        with open(CONF) as f:
            for line in f:
                line=line.strip()
                if not line or line.startswith("#"): continue
                m=re.match(r'^([A-Z_]+)\s*=\s*"?(.*?)"?\s*$',line)
                if not m: continue
                k,v=m.group(1),m.group(2)
                if k=="SUB_URLS": sub_urls=v.split()
                elif k=="EXTRA_HOSTS": extra=v.split()
    except: pass
    return sub_urls,extra

def fetch_links(url):
    try:
        req=urllib.request.Request(url,headers={"User-Agent":"adrenalin-ping","Accept":"*/*"})
        ctx=ssl.create_default_context();ctx.check_hostname=False;ctx.verify_mode=ssl.CERT_NONE
        with urllib.request.urlopen(req,timeout=10,context=ctx) as r:
            return r.read().decode("utf-8","ignore")
    except Exception as e:
        sys.stderr.write("fetch error: %s\n"%e);return ""

def extract_hosts(text):
    hosts=set()
    for m in re.finditer(r'@([a-zA-Z0-9._-]+):(\d+)',text):
        hosts.add((m.group(1),int(m.group(2)),"tcp"))
    for block in re.findall(r'\[Interface\][\s\S]*?(?=\[Interface\]|$)',text):
        m=re.search(r'Endpoint\s*=\s*\[?([^\]\s:]+?)\]?:(\d+)',block,re.I)
        if m: hosts.add((m.group(1),int(m.group(2)),"udp"))
    return hosts

def tcp_ping(host,port):
    times=[]
    for _ in range(3):
        try:
            t0=time.perf_counter()
            s=socket.create_connection((host,port),timeout=TIMEOUT)
            dt=(time.perf_counter()-t0)*1000
            s.close()
            times.append(dt)
        except: pass
    if not times: return None
    return round(statistics.median(times))

def icmp_ping(host):
    try:
        r=subprocess.run(["ping","-c","3","-W","2","-q",host],capture_output=True,text=True,timeout=10)
        m=re.search(r'rtt min/avg/max/mdev = [\d.]+/([\d.]+)',r.stdout)
        if m: return round(float(m.group(1)))
    except: pass
    return None

def main():
    sub_urls,extra=load_conf()
    text=""
    for u in sub_urls: text+=fetch_links(u)+"\n"
    hosts=extract_hosts(text)
    for h in extra:
        if ":" in h:
            a,p=h.rsplit(":",1)
            try: hosts.add((a,int(p),"tcp"))
            except: pass
    result={}
    for host,port,kind in hosts:
        key=host+":"+str(port)
        if kind=="udp":
            v=icmp_ping(host)
            if v is None: v=tcp_ping(host,port)
        else:
            v=tcp_ping(host,port)
        if v is None: v="timeout"
        result[key]=v
    os.makedirs(os.path.dirname(OUT),exist_ok=True)
    tmp=OUT+".tmp"
    with open(tmp,"w") as f:
        json.dump({"updated_at":int(time.time()*1000),"servers":result},f,ensure_ascii=False)
    os.replace(tmp,OUT)
    print("OK: %d hosts"%len(result))

if __name__=="__main__": main()